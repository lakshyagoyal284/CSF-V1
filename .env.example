# ---------------------------------------------------------------------------
# AgriTrust AI - environment template
# Copy to .env and fill in the values you need. Never commit .env.
# ---------------------------------------------------------------------------

# --- model -----------------------------------------------------------------
# Default is the model produced by `python train_model.py` (synthetic portfolio).
# The mixed-source model is experimental; see docs/MODEL_CARD.md before using it.
ACS_MODEL_PATH=artifacts/credit_model.pkl
ACS_REQUIRE_MODEL_ON_STARTUP=true

# --- portal database -------------------------------------------------------
# SQLite is the zero-config demo default.
# PostgreSQL example:
#   ACS_PORTAL_DATABASE_URL=postgresql+psycopg://agritrust:agritrust@localhost:5432/agritrust
ACS_PORTAL_DATABASE_URL=sqlite:///./data/agritrust.db
# auto = create on SQLite, never on PostgreSQL
ACS_PORTAL_CREATE_TABLES=
ACS_PORTAL_SEED_DEMO=false
# The zero-config SQLite demo can auto-create borrower accounts (per-database random
# passwords, logged once at startup). Banker accounts are NEVER created this way - set
# up bankers through a secure bootstrap. Only enable seeding on a disposable local DB.

# --- authentication --------------------------------------------------------
# MUST be changed for any shared or deployed environment.
ACS_JWT_SECRET=<generate-a-random-string-of-at-least-32-bytes>
# Required: the API refuses to start without a strong secret of at least 32 bytes
# and without an explicitly set value (no placeholder/empty/default allowed).
# Generate, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
ACS_JWT_ALGORITHM=HS256
ACS_JWT_ISSUER=agritrust-ai
# Access tokens are short-lived. Do not increase this to hours; long-lived bearer
# tokens stored in browser storage are a credential-theft risk.
ACS_JWT_EXPIRY_MINUTES=15

# --- document storage ------------------------------------------------------
ACS_UPLOAD_DIR=data/uploads
ACS_MAX_UPLOAD_MB=10

# --- API -------------------------------------------------------------------
ACS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACS_LOG_LEVEL=INFO

# --- legacy assessment persistence (optional) ------------------------------
# ACS_DATABASE_URL=postgresql+psycopg://acs:acs@localhost:5432/credit_scoring
# ACS_CREATE_TABLES_ON_STARTUP=false
# ACS_PERSIST_BY_DEFAULT=false

# --- frontend (frontend/.env.local) ---------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
